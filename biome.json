{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!.vitepress/cache",
      "!.vitepress/dist"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": { "correctness": { "noUnusedVariables": "off" } }
      }
    }
  ]
}
